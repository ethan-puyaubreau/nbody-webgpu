{
  "name": "nbody-webgpu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An N-body galaxy integrated on your GPU, in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome format --write",
    "check:code": "biome check && tsc --noEmit && vitest run",
    "check:style": "node scripts/check-style.mjs",
    "check": "pnpm check:code"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  }
}
